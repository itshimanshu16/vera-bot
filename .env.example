# Copy to your hosting provider's "Environment Variables" screen (never commit real keys).
CONTACT_EMAIL=your_roll_no@dtu.ac.in
TEAM_NAME=Shaurya Bhardwaj
TEAM_MEMBERS=Shaurya Bhardwaj

# Optional LLM layer. Leave LLM_API_KEY empty to run the pure rules engine (fully deterministic).
LLM_PROVIDER=gemini          # gemini | openai | groq | openrouter | deepseek | anthropic
LLM_API_KEY=
LLM_MODEL=                   # blank = provider default (gemini-2.5-flash for gemini)
LLM_MODE=smart               # off | smart | all
LLM_TIMEOUT=8
TICK_BUDGET_SECONDS=9
